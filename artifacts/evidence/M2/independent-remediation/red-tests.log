                    intent, RiskDecision(
                        intent_id=intent.intent_id, policy_hash="b" * 32, allow=True,
                        reason_codes=("POLICY_SATISFIED",), limits_snapshot={}, decision_at=NOW,
                    ), SYMBOL, "buy", Decimal("50"), stack["token"]
                )
            except Exception as exc:  # post-validation refusal surfaces here
                result["exception"] = exc
    
        t = threading.Thread(target=worker)
        t.start()
